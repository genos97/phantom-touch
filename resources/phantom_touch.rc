#include <winver.h>

101 ICON "phantom_touch.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Phantom Touch"
            VALUE "FileDescription", "Phantom Touch Emulator Shell & Multi-Touch Keymapper"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "PhantomTouch"
            VALUE "OriginalFilename", "PhantomTouch.exe"
            VALUE "ProductName", "Phantom Touch"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
